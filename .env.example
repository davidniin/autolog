# Copy this file to .env and fill it in. NEVER commit .env: it holds your secrets (it is in .gitignore).
# Copia este fichero a .env y rellénalo. NUNCA subas el .env al repositorio: tiene tus secretos.

# ---- Access / Acceso
# App password: a long random string (min. 16 chars). Generate one with:  openssl rand -hex 24
# Clave de la app: un texto largo y aleatorio (mín. 16 caracteres). Genérala con:  openssl rand -hex 24
AUTOLOG_TOKEN=

# ---- Database / Base de datos
# docker-compose.yml (bundled PostgreSQL): just pick a password. / Solo elige una contraseña.
POSTGRES_PASSWORD=
# docker-compose.external-db.yml or no Docker: full connection URL. / URL completa de conexión.
# DATABASE_URL=postgres://autolog:CHANGE_ME@host.docker.internal:5432/autolog

# ---- Network / Red
# Address and port published on the host. 127.0.0.1 = only reachable through your HTTPS proxy/tunnel (recommended).
# Dirección y puerto en el servidor. 127.0.0.1 = solo a través de tu proxy/túnel HTTPS (recomendado).
BIND_ADDR=127.0.0.1
HOST_PORT=8791
# Behind a reverse proxy (Caddy, Nginx, Cloudflare, your cloud platform): 1, to see the real client IP.
# Detrás de un proxy inverso: 1, para ver la IP real del cliente (límite de intentos).
TRUST_PROXY=0

# ---- Push notifications / Notificaciones push (reminders: MOT/ITV, oil, insurance...)
# Contact sent to push services (Google, Apple). Use a real address you own: Apple rejects made-up ones.
# Contacto para los servicios de push. Usa una dirección real tuya: Apple rechaza las inventadas.
PUSH_CONTACT=mailto:you@example.com
# Server hour for the daily reminder check / Hora del servidor para la revisión diaria
PUSH_HOUR=9
TZ=Europe/Madrid

# ---- Only for a private network with no internet access / Solo en una red privada sin acceso desde internet
# ALLOW_NO_AUTH=1
